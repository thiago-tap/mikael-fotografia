{
  "name": "mikael-fotografia",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "pdf": "node scripts/gerar-pdf.mjs",
    "pdf:dist": "node scripts/gerar-pdf.mjs --sem-build --saida dist/proposta-mikael-vt-fotografo.pdf",
    "test": "npm run build && npm run pdf:dist && playwright test",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "servir": "node scripts/servir-dist.mjs",
    "og": "node scripts/gerar-og.mjs",
    "otimizar-imagens": "node scripts/otimizar-imagens.mjs",
    "verificar-imagens": "node scripts/otimizar-imagens.mjs --verificar",
    "limpar-historico-imagens": "node scripts/limpar-historico-imagens.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
