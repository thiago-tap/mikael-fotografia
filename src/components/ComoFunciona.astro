---
import TituloSecao from './TituloSecao.astro';
import { etapas } from '../lib/conteudo';

const lista = await etapas();
---

<section class="px-6 py-24 md:py-32">
  <div class="mx-auto max-w-7xl">
    <TituloSecao sobrelinha="Do primeiro oi à galeria" titulo="Como funciona" />
    <ol
      style={`--etapas: ${lista.length}`}
      class="relative mt-16 grid gap-y-10 before:absolute before:top-2 before:bottom-2 before:left-[0.95rem] before:w-px before:bg-linha md:mt-20 lg:grid-cols-[repeat(var(--etapas),minmax(0,1fr))] lg:gap-x-6 lg:before:top-[1.05rem] lg:before:right-[calc(50%/var(--etapas))] lg:before:bottom-auto lg:before:left-[calc(50%/var(--etapas))] lg:before:h-px lg:before:w-auto"
    >
      {
        lista.map(({ data }, indice) => (
          <li class="relative grid grid-cols-[2rem_1fr] gap-x-6 lg:flex lg:flex-col lg:items-center lg:text-center" data-revelar style={`--atraso: ${indice * 90}ms`}>
            <span class="relative z-10 flex h-8 w-8 items-center justify-center rounded-full border border-linha bg-papel font-serif text-lg text-taupe lg:h-9 lg:w-9">
              {indice + 1}
            </span>
            <div class="lg:mt-6">
              <h3 class="font-serif text-titulo-4 text-tinta">{data.titulo}</h3>
              {data.detalhe && <p class="mt-1 font-serif text-lg text-taupe italic">{data.detalhe}</p>}
              <p class="mt-3 font-sans text-pequeno text-grafite">{data.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
