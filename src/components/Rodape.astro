---
import Icone from './Icone.astro';
import Marca from './Marca.astro';
import { linkWhatsApp, menu, rota, site } from '../lib/site';

const ano = new Date().getFullYear();
---

<footer class="border-t border-linha bg-papel">
  <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-3 md:px-10">
    <div class="flex flex-col items-center gap-5 md:items-start">
      <a href={rota('/')} aria-label="Mikael Fotografia, página inicial">
        <Marca />
      </a>
      <p class="max-w-xs text-center font-serif text-lg text-grafite italic md:text-left">{site.frase}</p>
    </div>

    <nav aria-label="Rodapé" class="flex justify-center">
      <ul class="grid grid-cols-2 gap-x-10 gap-y-1 text-center md:text-left">
        <li>
          <a href={rota('/proposta/')} class="inline-block py-2 font-sans text-[0.7rem] tracking-[0.28em] text-tinta uppercase hover:text-taupe">
            Proposta
          </a>
        </li>
        {
          menu.map((item) => (
            <li>
              <a
                href={rota(item.caminho)}
                class="inline-block py-2 font-sans text-[0.7rem] tracking-[0.28em] text-grafite uppercase hover:text-tinta"
              >
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-col items-center gap-1 md:items-end">
      <a
        href={linkWhatsApp()}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-3 py-2 font-sans text-sm tracking-wide text-grafite hover:text-tinta"
      >
        <Icone nome="whatsapp" class="h-4 w-4" />
        {site.whatsapp.exibicao}
      </a>
      <a
        href={site.instagram.url}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-3 py-2 font-sans text-sm tracking-wide text-grafite hover:text-tinta"
      >
        <Icone nome="instagram" class="h-4 w-4" />
        @{site.instagram.usuario}
      </a>
    </div>
  </div>

  <p class="border-t border-linha px-6 py-6 text-center font-sans text-[0.65rem] tracking-[0.3em] text-taupe uppercase">
    © {ano} {site.nome} · {site.fotografo}
  </p>
</footer>
