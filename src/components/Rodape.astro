---
import Icone from './Icone.astro';
import Marca from './Marca.astro';
import { menu } from '../lib/conteudo';
import { linkWhatsApp, regiao, rota, site } from '../lib/site';

const ano = new Date().getFullYear();
const itens = await menu();
---

<footer class="border-t border-linha" data-esconde-flutuante>
  <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-3 md:px-10">
    <div class="flex flex-col items-center gap-5 md:items-start">
      <a href={rota('/')} aria-label="Mikael Vt Fotógrafo, página inicial">
        <Marca />
      </a>
      <p class="max-w-xs text-center font-serif text-titulo-4 text-grafite italic md:text-left">{site.frase}</p>
      <p class="sobrelinha text-center md:text-left">Fotografia de casamento em {regiao}</p>
    </div>

    <nav aria-label="Rodapé" class="flex justify-center">
      <ul class="grid grid-cols-2 gap-x-10 gap-y-1 self-start text-center md:text-left">
        {
          itens.map((item) => (
            <li>
              <a href={rota(item.caminho)} class="link-navegacao py-2">
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-col items-center gap-1 md:items-end">
      <a
        href={linkWhatsApp()}
        target="_blank"
        rel="noopener"
        class="link-contato"
        data-evento="clique_whatsapp"
        data-origem="rodape"
      >
        <Icone nome="whatsapp" class="h-4 w-4" />
        {site.whatsapp.exibicao}
      </a>
      <a
        href={site.instagram.url}
        target="_blank"
        rel="noopener"
        class="link-contato"
        data-evento="clique_instagram"
        data-origem="rodape"
      >
        <Icone nome="instagram" class="h-4 w-4" />
        @{site.instagram.usuario}
      </a>
    </div>
  </div>

  <div class="border-t border-linha px-6 py-6 text-center font-sans text-taupe">
    <p class="text-rotulo tracking-[0.3em] uppercase">
      © {ano} {site.nome} · {regiao} ·{' '}
      <a href={rota('/privacidade/')} class="sublinhado-animado">Privacidade</a>
    </p>
    <p class="mt-3 text-[0.6875rem] tracking-[0.12em]">
      Desenvolvido por:{' '}
      <a
        href="https://www.instagram.com/thiagaotap/"
        target="_blank"
        rel="noopener noreferrer"
        class="sublinhado-animado hover:text-tinta"
        data-evento="clique_desenvolvedor"
        data-origem="rodape">Thiago Albuquerque</a
      >
    </p>
  </div>
</footer>
