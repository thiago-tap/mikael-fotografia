---
import type { CollectionEntry } from 'astro:content';
import FotoVaga from './FotoVaga.astro';
import Icone from './Icone.astro';
import PrecoPacote from './PrecoPacote.astro';
import { seloDoPacote } from '../lib/conteudo';
import { linkWhatsApp, mensagemPacote } from '../lib/site';
import type { Vaga } from '../lib/fotos';

interface Props {
  pacote: CollectionEntry<'pacotes'>;
  invertido?: boolean;
}

const { pacote, invertido = false } = Astro.props;
const { nome, preco, chamada, itens, idealPara, pagamento } = pacote.data;
const selo = seloDoPacote(pacote.data);
const vaga = `pacote-${pacote.id}` as Vaga;
---

<article id={pacote.id} class="grid scroll-mt-10 items-center gap-10 md:grid-cols-2 md:gap-16 lg:gap-24">
  <div class:list={[invertido && 'md:order-2']} data-revelar>
    <FotoVaga vaga={vaga} alt={`Casamento fotografado por Mikael Vt — pacote ${nome}`} sizes="(min-width: 768px) 50vw, 100vw" zoom />
  </div>

  <div class:list={['text-center md:text-left', invertido && 'md:order-1']} data-revelar style="--atraso: 120ms">
    {selo && <p class="sobrelinha mb-4 text-tinta">{selo}</p>}
    <h3 class="font-serif text-titulo-2 font-light tracking-[0.1em] text-tinta uppercase">{nome}</h3>
    {chamada && <p class="mt-4 font-serif text-titulo-4 text-grafite italic">{chamada}</p>}

    <ul class="mx-auto mt-8 max-w-md space-y-3 text-left md:mx-0">
      {
        itens.map((item) => (
          <li class="flex gap-3 font-sans text-corpo leading-relaxed text-grafite">
            <span class="text-taupe" aria-hidden="true">•</span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>

    {
      idealPara && (
        <div class="mt-8 border-t border-linha pt-6">
          <p class="sobrelinha">Ideal para</p>
          <p class="mt-2 font-serif text-titulo-4 text-grafite italic">{idealPara}</p>
        </div>
      )
    }

    <div class="mt-8">
      <PrecoPacote preco={preco} pagamento={pagamento} tamanho="grande" />
    </div>

    <a
      href={linkWhatsApp(mensagemPacote(nome))}
      target="_blank"
      rel="noopener"
      class="botao mt-8"
      data-evento="clique_whatsapp"
      data-origem={`pacote:${nome}`}
    >
      <Icone nome="whatsapp" class="h-4 w-4" />
      Consultar data para este pacote
    </a>
  </div>
</article>
