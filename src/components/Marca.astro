---
import { Image } from 'astro:assets';
import { ehSvg, logo, logoClaro } from '../lib/marca';
import { site } from '../lib/site';

const tamanhos = {
  normal: { altura: 48, imagem: 'h-9 md:h-12', nome: 'text-xl md:text-2xl', complemento: 'mt-1.5 text-[0.55rem]' },
  grande: { altura: 80, imagem: 'h-20', nome: 'text-4xl md:text-5xl', complemento: 'mt-3 text-xs' },
  capa: { altura: 150, imagem: 'h-[150px]', nome: 'text-[64px]', complemento: 'mt-5 text-[18px]' },
  contato: { altura: 90, imagem: 'h-[90px]', nome: 'text-[44px]', complemento: 'mt-4 text-[14px]' },
};

interface Props {
  tamanho?: keyof typeof tamanhos;
  escuro?: boolean;
}

const { tamanho = 'normal', escuro = false } = Astro.props;
const imagem = escuro ? logoClaro : logo;
const medida = tamanhos[tamanho];
const classesImagem = ['w-auto max-w-full object-contain', medida.imagem];
---

{
  imagem ? (
    ehSvg(imagem) ? (
      <img
        src={imagem.src}
        alt={site.nome}
        width={Math.round((imagem.width / imagem.height) * medida.altura)}
        height={medida.altura}
        class:list={classesImagem}
      />
    ) : (
      <Image src={imagem} alt={site.nome} height={medida.altura} densities={[1, 2]} loading="eager" class:list={classesImagem} />
    )
  ) : (
    <span class="flex flex-col items-center leading-none">
      <span class:list={['-mr-[0.3em] font-serif font-light tracking-[0.3em] whitespace-nowrap', escuro ? 'text-papel' : 'text-tinta', medida.nome]}>{site.marca.nome}</span>
      <span class:list={['-mr-[0.5em] font-sans tracking-[0.5em]', escuro ? 'text-papel/70' : 'text-taupe', medida.complemento]}>{site.marca.complemento}</span>
    </span>
  )
}
