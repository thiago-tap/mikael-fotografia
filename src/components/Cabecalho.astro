---
import Marca from './Marca.astro';
import { menu, rota } from '../lib/site';

const atual = Astro.url.pathname;
const ativo = (caminho: string) => atual.startsWith(rota(caminho));
---

<header class="relative z-30 bg-papel">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 md:px-10 md:py-8">
    <a href={rota('/')} aria-label="Mikael Fotografia, página inicial">
      <Marca />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-10">
        {
          menu.map((item) => (
            <li>
              <a
                href={rota(item.caminho)}
                aria-current={ativo(item.caminho) ? 'page' : undefined}
                class:list={[
                  'border-b pb-1 font-sans text-[0.7rem] tracking-[0.3em] uppercase transition-colors',
                  ativo(item.caminho)
                    ? 'border-tinta text-tinta'
                    : 'border-transparent text-grafite hover:border-linha hover:text-tinta',
                ]}
              >
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      class="flex h-11 w-11 items-center justify-center lg:hidden"
      aria-expanded="false"
      aria-controls="menu-movel"
      data-menu-botao
    >
      <span class="sr-only">Abrir menu</span>
      <span class="relative block h-3 w-7" aria-hidden="true">
        <span class="absolute top-0 left-0 h-px w-full bg-tinta transition-transform" data-linha="1"></span>
        <span class="absolute bottom-0 left-0 h-px w-full bg-tinta transition-transform" data-linha="2"></span>
      </span>
    </button>
  </div>

  <nav
    id="menu-movel"
    aria-label="Principal"
    class="hidden border-t border-linha bg-papel lg:hidden"
    data-menu-painel
  >
    <ul class="flex flex-col px-6 py-6">
      {
        menu.map((item) => (
          <li>
            <a
              href={rota(item.caminho)}
              aria-current={ativo(item.caminho) ? 'page' : undefined}
              class:list={[
                'block py-3 font-sans text-xs tracking-[0.3em] uppercase',
                ativo(item.caminho) ? 'text-tinta' : 'text-grafite',
              ]}
            >
              {item.rotulo}
            </a>
          </li>
        ))
      }
      <li class="mt-4">
        <a href={rota('/proposta/')} class="botao w-full">Ver a proposta</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const botao = document.querySelector<HTMLButtonElement>('[data-menu-botao]');
  const painel = document.querySelector<HTMLElement>('[data-menu-painel]');

  botao?.addEventListener('click', () => {
    const aberto = botao.getAttribute('aria-expanded') === 'true';
    botao.setAttribute('aria-expanded', String(!aberto));
    botao.querySelector('.sr-only')!.textContent = aberto ? 'Abrir menu' : 'Fechar menu';
    painel?.classList.toggle('hidden', aberto);
    botao.querySelector<HTMLElement>('[data-linha="1"]')!.style.transform = aberto ? '' : 'translateY(5.5px) rotate(45deg)';
    botao.querySelector<HTMLElement>('[data-linha="2"]')!.style.transform = aberto ? '' : 'translateY(-5.5px) rotate(-45deg)';
  });
</script>
