---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { posicaoDoFoco, type Foco } from '../lib/enquadramento';
import { focoDaVaga, fotoDoSite, formatos, larguras, miniatura, vagas, type Vaga } from '../lib/fotos';

type Props = {
  alt: string;
  sobrelinha: string;
  titulo: string;
  enfase?: string;
} & ({ vaga: Vaga; imagem?: never; foco?: never } | { vaga?: never; imagem?: ImageMetadata; foco?: Foco });

const { vaga, alt, sobrelinha, titulo, enfase } = Astro.props;
const imagem = vaga ? fotoDoSite(vaga) : Astro.props.imagem;
const posicao = posicaoDoFoco(vaga ? focoDaVaga(vaga) : (Astro.props.foco ?? 'centro'));
const borrada = await miniatura(imagem);
const aviso = vaga ? `Foto 3:2 · ${vaga} · ${vagas[vaga].medida}` : 'Foto de capa · 3:2 horizontal';
---

<section
  class:list={[
    'relative isolate flex min-h-[calc(100svh-var(--altura-cabecalho))] items-end overflow-hidden',
    imagem ? 'bg-tinta' : 'bg-taupe',
  ]}
  data-hero
>
  {
    imagem ? (
      <div
        class:list={['absolute inset-0 -z-20', borrada && 'foto-suave']}
        style={[`--foco: ${posicao}`, borrada && `--lqip: url(${borrada})`].filter(Boolean).join('; ')}
      >
        <Picture
          src={imagem}
          alt={alt}
          widths={larguras(imagem)}
          sizes="(max-aspect-ratio: 3/2) 150vh, 100vw"
          formats={formatos}
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full animate-aproximar object-cover"
          style={`object-position: ${posicao}`}
        />
      </div>
    ) : (
      <div class="absolute inset-x-6 top-6 -z-20 flex justify-center md:top-10" role="img" aria-label={alt}>
        <span class="border border-dashed border-papel/30 px-4 py-2 font-sans text-xs tracking-wide text-papel/75">{aviso}</span>
      </div>
    )
  }
  <div
    class="absolute inset-0 -z-10 bg-tinta/20 bg-linear-to-t from-tinta/85 via-tinta/45 via-50% to-tinta/0 md:bg-tinta/10"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto w-full max-w-6xl px-6 pt-28 pb-12 text-center text-papel [text-shadow:0_1px_28px_rgb(0_0_0/0.22)] md:px-10 md:pb-20">
    <p class="sobrelinha animate-surgir text-papel/85">{sobrelinha}</p>
    <h1 class="mx-auto mt-5 max-w-5xl animate-surgir font-serif text-manchete font-light text-balance [animation-delay:120ms]">
      {titulo}
      {enfase && <span class="block italic">{enfase}</span>}
    </h1>
    <div class="animate-surgir [animation-delay:260ms]">
      <slot />
    </div>
  </div>
</section>
