---
import { numerosDoSite } from '../lib/conteudo';

const numeros = await numerosDoSite();
---

{
  numeros.length > 0 && (
    <section class="border-y border-linha px-6" aria-label="Em números">
      <ul class="mx-auto grid max-w-6xl grid-cols-2 lg:grid-cols-4">
        {numeros.map(({ valor, rotulo }, indice) => (
          <li
            class:list={[
              'flex flex-col items-center px-4 py-10 text-center md:py-14',
              indice % 2 === 1 && 'border-l border-linha',
              indice >= 2 && 'max-lg:border-t max-lg:border-linha',
              indice === 2 && 'lg:border-l',
            ]}
            data-revelar
            style={`--atraso: ${indice * 90}ms`}
          >
            <span class="font-serif text-preco font-light text-tinta tabular-nums" data-contar={valor}>
              {valor}
            </span>
            <span class="mt-3 font-sans text-rotulo tracking-[0.24em] text-taupe uppercase">{rotulo}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<script>
  const numeros = document.querySelectorAll<HTMLElement>('[data-contar]');
  const movimentoReduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (numeros.length > 0 && !movimentoReduzido && 'IntersectionObserver' in window) {
    const duracao = 1400;
    const contar = (elemento: HTMLElement) => {
      const final = Number(elemento.dataset.contar);
      const inicio = performance.now();
      const passo = (agora: number) => {
        const progresso = Math.min(1, (agora - inicio) / duracao);
        const suave = 1 - Math.pow(1 - progresso, 3);
        elemento.textContent = String(Math.round(final * suave));
        if (progresso < 1) requestAnimationFrame(passo);
      };
      requestAnimationFrame(passo);
    };

    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          observador.unobserve(entrada.target);
          contar(entrada.target as HTMLElement);
        }
      },
      { threshold: 0.6 },
    );

    for (const numero of numeros) {
      const caixa = numero.getBoundingClientRect();
      if (caixa.top < innerHeight && caixa.bottom > 0) continue;
      numero.textContent = '0';
      observador.observe(numero);
    }
  }
</script>
