---
import TituloSecao from './TituloSecao.astro';
import { diferenciais } from '../lib/conteudo';

const lista = await diferenciais();
---

<section class="bg-areia px-6 py-24 md:py-32">
  <div class="mx-auto max-w-6xl">
    <TituloSecao sobrelinha="Por que Mikael Fotografia?" titulo="Cuidamos do seu dia" enfase="como se fosse nosso." />
    <ul class="mt-16 grid gap-x-12 gap-y-12 sm:grid-cols-2 lg:grid-cols-5">
      {
        lista.map(({ data }, indice) => (
          <li class="text-center" data-revelar style={`--atraso: ${indice * 90}ms`}>
            <p class="font-serif text-titulo-3 font-light text-taupe italic">{String(indice + 1).padStart(2, '0')}</p>
            <h3 class="mt-4 font-sans text-rotulo font-normal tracking-[0.26em] text-tinta uppercase">{data.titulo}</h3>
            <p class="mt-4 font-sans text-pequeno text-grafite">{data.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
