---
import type { CollectionEntry } from 'astro:content';
import Foto from './Foto.astro';
import { capaDoCasamento, partesDoCasal } from '../lib/casamentos';
import { lugarDoCasamento } from '../lib/conteudo';
import { rota } from '../lib/site';

interface Props {
  casamento: CollectionEntry<'casamentos'>;
  sizes?: string;
  nivel?: 'h2' | 'h3';
}

const { casamento, sizes = '(min-width: 768px) 33vw, 100vw', nivel = 'h3' } = Astro.props;
const { casal, data, capa, resumo } = casamento.data;
const Tag = nivel;
const lugar = lugarDoCasamento(casamento.data);
const detalhe = [lugar, data && String(data.getUTCFullYear())].filter(Boolean).join(' · ');
---

<a href={rota(`/casamentos/${casamento.id}/`)} class="group block">
  <Foto
    imagem={capaDoCasamento(casamento)}
    alt={capa.alt ?? `Casamento de ${casal}`}
    proporcao="4:5"
    foco={capa.foco}
    aguardando="capa · 4:5"
    sizes={sizes}
    larguraMaxima={1200}
    zoom
  />
  {detalhe && <p class="sobrelinha mt-6">{detalhe}</p>}
  <Tag class="mt-3 font-serif text-titulo-3 font-light text-tinta transition-colors group-hover:text-taupe">
    {partesDoCasal(casal).map((parte, indice) => (indice % 2 === 1 ? <em class="font-light"> {parte} </em> : parte))}
  </Tag>
  <p class="mt-3 line-clamp-3 font-sans text-pequeno text-grafite">{resumo}</p>
</a>
