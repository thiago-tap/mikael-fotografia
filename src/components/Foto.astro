---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { posicaoDoFoco, type Foco } from '../lib/enquadramento';
import { formatos, larguras, miniatura, type Proporcao } from '../lib/fotos';

interface Props {
  imagem?: ImageMetadata;
  alt: string;
  /** Sem proporção, a altura vem da classe recebida (ex.: h-full). "original" usa a proporção do arquivo. */
  proporcao?: Proporcao | 'original';
  foco?: Foco;
  /** Texto do espaço reservado enquanto a foto não chega, ex.: "home-hero · 3000 × 2000 px". */
  aguardando: string;
  sizes?: string;
  larguraMaxima?: number;
  carregamento?: 'eager' | 'lazy';
  zoom?: boolean;
  class?: string;
}

const {
  imagem,
  alt,
  proporcao,
  foco = 'centro',
  aguardando,
  sizes = '100vw',
  larguraMaxima = 2400,
  carregamento = 'lazy',
  zoom = false,
  class: classe = '',
} = Astro.props;

const proporcoes: Record<Proporcao, string> = {
  '3:2': 'aspect-[3/2]',
  '4:5': 'aspect-[4/5]',
  '16:9': 'aspect-[16/9]',
  '2:3': 'aspect-[2/3]',
  '9:16': 'aspect-[9/16]',
  '3:4': 'aspect-[3/4]',
  '1:1': 'aspect-square',
};

const posicao = posicaoDoFoco(foco);
const borrada = await miniatura(imagem);
const original = proporcao === 'original';
const estilo = [
  `--foco: ${posicao}`,
  borrada && `--lqip: url(${borrada})`,
  original && imagem && `aspect-ratio: ${imagem.width} / ${imagem.height}`,
]
  .filter(Boolean)
  .join('; ');
const rotuloProporcao = proporcao && !original ? proporcao : imagem ? '' : 'livre';
---

<div
  class:list={[
    'relative overflow-hidden bg-areia',
    proporcao && !original && proporcoes[proporcao],
    original && !imagem && 'aspect-[4/5]',
    borrada && 'foto-suave',
    zoom && 'group',
    classe,
  ]}
  style={estilo}
>
  {
    imagem ? (
      <Picture
        src={imagem}
        alt={alt}
        widths={larguras(imagem, larguraMaxima)}
        sizes={sizes}
        formats={formatos}
        loading={carregamento}
        fetchpriority={carregamento === 'eager' ? 'high' : 'auto'}
        class:list={['absolute inset-0 h-full w-full object-cover', zoom && 'zoom-suave']}
        style={`object-position: ${posicao}`}
      />
    ) : (
      <div
        class="absolute inset-0 flex flex-col items-center justify-center gap-3 border border-dashed border-linha p-6 text-center"
        role="img"
        aria-label={alt}
      >
        <svg class="h-7 w-7 text-taupe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
          <rect x="3" y="6" width="18" height="14" rx="1" />
          <circle cx="12" cy="13" r="3.5" />
          <path d="M8 6l1.5-2h5L16 6" />
        </svg>
        <span class="sobrelinha">Foto {rotuloProporcao}</span>
        <span class="font-sans text-xs tracking-wide text-grafite">{aguardando}</span>
      </div>
    )
  }
</div>
