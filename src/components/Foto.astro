---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { larguras, type Proporcao } from '../lib/fotos';

interface Props {
  imagem?: ImageMetadata;
  alt: string;
  proporcao: Proporcao;
  /** Texto do espaço reservado enquanto a foto não chega, ex.: "home-hero · 3000 × 2000 px". */
  aguardando: string;
  sizes?: string;
  carregamento?: 'eager' | 'lazy';
  class?: string;
}

const {
  imagem,
  alt,
  proporcao,
  aguardando,
  sizes = '100vw',
  carregamento = 'lazy',
  class: classe = '',
} = Astro.props;

const proporcoes: Record<Proporcao, string> = {
  '3:2': 'aspect-[3/2]',
  '4:5': 'aspect-[4/5]',
  '16:9': 'aspect-[16/9]',
  '2:3': 'aspect-[2/3]',
  '9:16': 'aspect-[9/16]',
};
---

<div class:list={['relative overflow-hidden bg-areia', proporcoes[proporcao], classe]}>
  {
    imagem ? (
      <Image
        src={imagem}
        alt={alt}
        widths={larguras(imagem)}
        sizes={sizes}
        loading={carregamento}
        fetchpriority={carregamento === 'eager' ? 'high' : 'auto'}
        class="absolute inset-0 h-full w-full object-cover"
      />
    ) : (
      <div
        class="absolute inset-0 flex flex-col items-center justify-center gap-3 border border-dashed border-linha p-6 text-center"
        role="img"
        aria-label={alt}
      >
        <svg class="h-7 w-7 text-taupe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
          <rect x="3" y="6" width="18" height="14" rx="1" />
          <circle cx="12" cy="13" r="3.5" />
          <path d="M8 6l1.5-2h5L16 6" />
        </svg>
        <span class="sobrelinha">Foto {proporcao}</span>
        <span class="font-sans text-xs tracking-wide text-grafite">{aguardando}</span>
      </div>
    )
  }
</div>
