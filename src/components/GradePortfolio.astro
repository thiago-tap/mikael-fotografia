---
import GradeEditorial from './GradeEditorial.astro';
import type { FotoEditorial } from '../lib/editorial';
import { fotosPortfolio } from '../lib/fotos';

interface Props {
  limite?: number;
  /** Quantos espaços vazios mostrar enquanto a pasta do portfólio estiver vazia. */
  vazios?: number;
  citacoes?: string[];
}

const { limite, vazios = 9, citacoes = [] } = Astro.props;
const fotos: FotoEditorial[] = fotosPortfolio().slice(0, limite);

const ritmoVazio = ['horizontal', 'vertical', 'horizontal', 'horizontal', 'vertical', 'vertical', 'horizontal', 'vertical', 'vertical'] as const;
const espacos: FotoEditorial[] = ritmoVazio.slice(0, Math.min(vazios, limite ?? vazios)).map((orientacao, indice) => ({
  alt: 'Espaço reservado para foto do portfólio',
  foco: 'centro',
  tamanho: 'auto',
  orientacaoVazia: orientacao,
  aguardando: `portfolio/${String(indice + 1).padStart(2, '0')} · ${orientacao === 'horizontal' ? '2400 × 1600' : '1600 × 2000'} px`,
}));
---

<GradeEditorial fotos={fotos.length > 0 ? fotos : espacos} grupo="portfolio" citacoes={citacoes} />
