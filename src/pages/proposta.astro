---
import Base from '../layouts/Base.astro';
import CardPacote from '../components/CardPacote.astro';
import ChamadaWhatsApp from '../components/ChamadaWhatsApp.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import ComparativoPacotes from '../components/ComparativoPacotes.astro';
import Diferenciais from '../components/Diferenciais.astro';
import FaixaAgenda from '../components/FaixaAgenda.astro';
import FotoVaga from '../components/FotoVaga.astro';
import Hero from '../components/Hero.astro';
import Icone from '../components/Icone.astro';
import ListaExtras from '../components/ListaExtras.astro';
import ListaFaq from '../components/ListaFaq.astro';
import Manifesto from '../components/Manifesto.astro';
import TituloSecao from '../components/TituloSecao.astro';
import { extras, pacotes, perguntas, sobre } from '../lib/conteudo';
import { linkWhatsApp, mensagemDisponibilidade, regiao, rota, site } from '../lib/site';

const [listaPacotes, listaExtras, faqResumido, paginaSobre] = await Promise.all([
  pacotes(),
  extras(),
  perguntas({ somenteProposta: true }),
  sobre(),
]);

const catalogo = {
  '@type': 'OfferCatalog',
  name: `Pacotes de fotografia de casamento · ${site.nome}`,
  url: new URL(rota('/proposta/'), Astro.site).href,
  itemListElement: listaPacotes.map((pacote) => ({
    '@type': 'Offer',
    name: `Pacote ${pacote.data.nome}`,
    url: new URL(rota(`/proposta/#${pacote.id}`), Astro.site).href,
    price: pacote.data.preco,
    priceCurrency: 'BRL',
    seller: { '@id': `${new URL(rota('/'), Astro.site)}#negocio` },
    itemOffered: {
      '@type': 'Service',
      name: `Fotografia de casamento · ${pacote.data.nome}`,
      serviceType: 'Fotografia de casamento',
      description: pacote.data.itens.join('; '),
      areaServed: regiao,
    },
  })),
};
---

<Base
  titulo={`Proposta de fotografia de casamento em ${regiao}`}
  descricao={`Pacotes Micro Wedding, Mini Wedding, Promessa e Eternidade para casamentos em ${regiao}: comparativo, serviços extras, formas de pagamento e como funciona.`}
  trilha={[{ nome: 'Proposta', caminho: rota('/proposta/') }]}
  dados={[catalogo]}
>
  <Hero
    vaga="proposta-hero"
    alt="Casal no dia do casamento, fotografado por Mikael Fotografia"
    sobrelinha="Proposta de fotografia para casamento"
    titulo="Fotografia de casamento"
    enfase={`em ${site.cidade}`}
  >
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4 md:mt-12">
      <a
        href={linkWhatsApp(mensagemDisponibilidade('a proposta'))}
        target="_blank"
        rel="noopener"
        class="botao-claro w-full max-w-sm sm:w-auto sm:max-w-none"
        data-evento="clique_whatsapp"
        data-origem="hero"
      >
        <Icone nome="whatsapp" class="h-4 w-4" />
        Consultar disponibilidade da minha data
      </a>
      <a href="#pacotes" class="botao-contorno-claro w-full max-w-sm sm:w-auto sm:max-w-none">Ver os pacotes</a>
    </div>
  </Hero>

  <nav aria-label="Pacotes" class="border-b border-linha px-6 py-5">
    <ul class="flex flex-wrap justify-center gap-x-8 gap-y-1">
      {
        listaPacotes.map((pacote) => (
          <li>
            <a href={`#${pacote.id}`} class="link-navegacao pt-2">
              {pacote.data.nome}
            </a>
          </li>
        ))
      }
      <li><a href="#comparativo" class="link-navegacao pt-2">Comparativo</a></li>
      <li><a href="#extras" class="link-navegacao pt-2">Extras</a></li>
    </ul>
  </nav>

  <FaixaAgenda />

  <section class="px-6 py-24 md:py-32">
    <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-[2fr_3fr] md:gap-20">
      <div data-revelar>
        <FotoVaga vaga="sobre-retrato" alt="Retrato do fotógrafo Mikael Vitor" sizes="(min-width: 768px) 40vw, 100vw" />
      </div>
      <div class="text-center md:text-left">
        <TituloSecao sobrelinha={paginaSobre.data.subtitulo} titulo={paginaSobre.data.titulo} alinhamento="esquerda" class="text-center md:text-left" />
        <p class="texto-corrido mt-8" data-revelar>{paginaSobre.data.resumo}</p>
        <a href={rota('/sobre/')} class="link-editorial mt-8">Saiba mais sobre mim</a>
      </div>
    </div>
  </section>

  <section id="pacotes" class="scroll-mt-6 border-t border-linha px-6 py-24 md:py-32">
    <div class="mx-auto max-w-6xl">
      <TituloSecao sobrelinha="Investimento" titulo="Pacotes" />
      <div class="mt-20 space-y-28 md:space-y-36">
        {listaPacotes.map((pacote, indice) => <CardPacote pacote={pacote} invertido={indice % 2 === 1} />)}
      </div>
    </div>
  </section>

  <section id="comparativo" class="scroll-mt-6 border-t border-linha py-24 md:py-32">
    <div class="mx-auto max-w-6xl">
      <TituloSecao sobrelinha="Lado a lado" titulo="Compare os" enfase="pacotes" class="px-6" />
      <div class="mt-14 md:px-6">
        <ComparativoPacotes pacotes={listaPacotes} />
      </div>
      <p class="mt-12 px-6 text-center">
        <a
          href={rota('/proposta-mikael-fotografia.pdf')}
          class="botao"
          download
          data-evento="download_pdf"
          data-origem="proposta"
        >
          <Icone nome="download" class="h-4 w-4" />
          Baixar proposta em PDF
        </a>
      </p>
    </div>
  </section>

  <div class="border-t border-linha">
    <ComoFunciona />
  </div>

  <section id="extras" class="scroll-mt-6 border-t border-linha px-6 py-24 md:py-32">
    <TituloSecao sobrelinha="Para acrescentar à sua cobertura" titulo="Serviços extras" />
    <div class="mt-16">
      <ListaExtras extras={listaExtras} />
    </div>
  </section>

  <FotoVaga vaga="faixa" alt="Detalhe de casamento fotografado por Mikael Fotografia" class="md:aspect-[12/5]" />

  <Diferenciais />

  <section class="px-6 py-24 md:py-32">
    <TituloSecao sobrelinha="Perguntas frequentes" titulo="Antes de reservar" />
    <div class="mt-16">
      <ListaFaq perguntas={faqResumido} />
    </div>
    <p class="mt-12 text-center">
      <a href={rota('/faq/')} class="botao">Ver todas as perguntas</a>
    </p>
  </section>

  <Manifesto texto="No dia, vocês só precisam viver. O resto é com a gente." />

  <ChamadaWhatsApp />
</Base>
