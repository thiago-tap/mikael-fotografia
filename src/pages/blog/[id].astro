---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChamadaWhatsApp from '../../components/ChamadaWhatsApp.astro';
import Foto from '../../components/Foto.astro';
import { formatarData, posts } from '../../lib/conteudo';
import { imagemDoRepositorio, versaoAmpliada } from '../../lib/fotos';
import { rota } from '../../lib/site';

export const getStaticPaths = (async () => {
  return (await posts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const capa = imagemDoRepositorio(post.data.capa, 'src/content/blog');
const capaAmpliada = capa && (await versaoAmpliada(capa));
---

<Base
  titulo={post.data.titulo}
  descricao={post.data.descricao}
  imagemSocial={capa?.src}
  leitura
  trilha={[
    { nome: 'Blog', caminho: rota('/blog/') },
    { nome: post.data.titulo, caminho: Astro.url.pathname },
  ]}
>
  <article class="px-6 pt-16 pb-24 md:pt-24" data-leitura>
    <header class="mx-auto max-w-3xl text-center">
      <p class="sobrelinha">{formatarData(post.data.data)}</p>
      <h1 class="mt-5 font-serif text-titulo-1 font-light text-balance text-tinta">{post.data.titulo}</h1>
      <p class="mt-6 font-sans text-corpo text-grafite">{post.data.descricao}</p>
    </header>

    {
      capa && capaAmpliada && (
        <a href={capaAmpliada} class="mx-auto mt-14 block max-w-6xl cursor-zoom-in" data-lightbox="blog">
          <Foto
            imagem={capa}
            alt={post.data.capaAlt ?? post.data.titulo}
            proporcao="3:2"
            foco={post.data.capaFoco}
            aguardando=""
            sizes="(min-width: 1280px) 1200px, 100vw"
            carregamento="eager"
          />
        </a>
      )
    }

    <div class="texto-corrido mx-auto mt-14 max-w-2xl">
      <Content />
    </div>

    <p class="mt-16 text-center">
      <a href={rota('/blog/')} class="botao">Voltar ao blog</a>
    </p>
  </article>

  <div class="border-t border-linha">
    <ChamadaWhatsApp titulo="Quer ver como seria o seu casamento?" />
  </div>
</Base>
