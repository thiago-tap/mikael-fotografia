---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import WhatsAppFlutuante from '../components/WhatsAppFlutuante.astro';
import { rota, site } from '../lib/site';

interface Props {
  titulo?: string;
  descricao?: string;
  imagemSocial?: string;
}

const { titulo, descricao = site.descricao, imagemSocial } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${site.nome}` : `${site.nome} · Fotografia de casamento`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagemOg = imagemSocial ? new URL(imagemSocial, Astro.site) : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" type="image/svg+xml" href={rota('/favicon.svg')} />
    <link rel="sitemap" href={rota('/sitemap-index.xml')} />
    <meta name="theme-color" content="#faf8f5" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    {imagemOg && <meta property="og:image" content={imagemOg} />}
    <meta name="twitter:card" content={imagemOg ? 'summary_large_image' : 'summary'} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-tinta focus:px-4 focus:py-2 focus:text-papel"
    >
      Pular para o conteúdo
    </a>
    <Cabecalho />
    <main id="conteudo" class="flex-1">
      <slot />
    </main>
    <Rodape />
    <WhatsAppFlutuante />
  </body>
</html>
